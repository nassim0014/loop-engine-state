{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settings.schema.json",
  "title": "Loop Settings",
  "type": "object",
  "required": ["version", "merge_policy"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "merge_policy": {
      "type": "object",
      "required": ["auto_merge_cap_per_run", "auto_merge_weekly_cap",
                    "stale_pr_days", "max_pr_diff_lines", "forbidden_paths"],
      "properties": {
        "auto_merge_cap_per_run": { "type": "integer", "minimum": 0, "maximum": 10 },
        "auto_merge_weekly_cap": { "type": "integer", "minimum": 0, "maximum": 20 },
        "budget_reset": { "enum": ["monday_00:00_local"] },
        "budget_source": { "enum": ["github_truth", "state_counter"] },
        "budget_counts": { "enum": ["agent_marker_prs_only", "all_auto_merges"] },
        "stale_pr_days": { "type": "integer", "minimum": 1 },
        "max_pr_diff_lines": { "type": "integer", "minimum": 1 },
        "forbidden_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "rotation_policy": {
      "type": "object",
      "properties": {
        "repos_per_run": { "type": "integer", "minimum": 1 },
        "items_per_repo": { "type": "integer", "minimum": 1 }
      }
    },
    "genesis": {
      "type": "object",
      "properties": {
        "cadence_days": { "type": "integer", "minimum": 7 },
        "min_days_between_runs": { "type": "integer", "minimum": 7 },
        "duplicate_guard_days": { "type": "integer", "minimum": 1 },
        "stale_lease_hours": { "type": "integer", "minimum": 1 }
      }
    },
    "markers": {
      "type": "object",
      "required": ["agents"],
      "properties": {
        "agents": { "type": "array", "minItems": 1, "items": { "enum": ["claude", "z-ai"] } }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "dependabot_rebase_attempts": { "type": "integer", "minimum": 0 },
        "pr_ci_poll_minutes": { "type": "integer", "minimum": 5 }
      }
    }
  }
}
