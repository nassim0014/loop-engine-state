{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settings.schema.json",
  "title": "Loop Settings",
  "type": "object",
  "required": ["version", "merge_policy"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "merge_policy": {
      "type": "object",
      "description": "Owner decision 2026-09-23: no merge caps. What stays is what keeps CI meaningful.",
      "required": ["auto_merge", "require_ci_passed", "protected_paths", "never_weaken_tests"],
      "properties": {
        "auto_merge": { "type": "boolean" },
        "merge_method": { "enum": ["squash", "merge", "rebase"] },
        "require_ci_passed": { "const": true },
        "protected_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "const": ".github/workflows/**" }
        },
        "protected_paths_rule": { "type": "string" },
        "never_weaken_tests": { "const": true },
        "stale_pr_days": { "type": "integer", "minimum": 1 }
      }
    },
    "rotation_policy": {
      "type": "object",
      "properties": {
        "repos_per_run": { "type": "integer", "minimum": 1 },
        "items_per_repo": { "type": "integer", "minimum": 1 }
      }
    },
    "genesis": {
      "type": "object",
      "properties": {
        "cadence_days": { "type": "integer", "minimum": 7 },
        "min_days_between_runs": { "type": "integer", "minimum": 7 },
        "duplicate_guard_days": { "type": "integer", "minimum": 1 },
        "stale_lease_hours": { "type": "integer", "minimum": 1 }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "dependabot_rebase_attempts": { "type": "integer", "minimum": 0 },
        "pr_ci_poll_minutes": { "type": "integer", "minimum": 5 }
      }
    }
  }
}
