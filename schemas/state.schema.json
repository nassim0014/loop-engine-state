{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state.schema.json",
  "title": "Loop Engine State",
  "type": "object",
  "required": ["version", "rotation_cursor", "loops"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "rotation_cursor": { "type": "integer", "minimum": 0 },
    "loops": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["last_run", "status"],
        "properties": {
          "last_run": { "type": ["string", "null"], "format": "date-time" },
          "status": { "enum": ["idle", "running", "done", "failed", "paused"] },
          "consecutive_failures": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    },
    "merge_budget": {
      "type": "object",
      "required": ["week_iso", "merges_this_week"],
      "properties": {
        "week_iso": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
        "merges_this_week": { "type": "integer", "minimum": 0 },
        "opened_this_week": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
