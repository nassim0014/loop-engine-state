{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "venv/bin/streamlit",
      "runtimeArgs": [
        "run",
        "dashboard/app.py",
        "--server.headless",
        "true"
      ],
      "port": 8501,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "venv/bin/uvicorn",
      "runtimeArgs": [
        "api.main:app",
        "--host",
        "0.0.0.0"
      ],
      "port": 8000,
      "autoPort": true
    }
  ]
}
