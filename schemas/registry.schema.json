{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "registry.schema.json",
  "title": "Loop Engine Registry",
  "type": "object",
  "required": ["version", "repos", "rotation"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "owner", "in_rotation", "role"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "owner": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
          "visibility": { "enum": ["public", "private"] },
          "in_rotation": { "type": "boolean" },
          "role": { "enum": ["rotation", "bridge", "read-only", "cloud-owned"] },
          "created_by": { "enum": ["manual", "genesis-loop"] },
          "worked_by": {
            "description": "The one agent that starts new work here, so two agents never work the same repo. Maintenance may still merge green PRs anywhere.",
            "enum": ["claude", "zai", "none"]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "rotation": {
      "type": "object",
      "required": ["order"],
      "properties": {
        "order": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    }
  }
}
