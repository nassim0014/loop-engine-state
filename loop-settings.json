{
  "version": 3,
  "merge_policy": {
    "auto_merge": true,
    "merge_method": "squash",
    "require_ci_passed": true,
    "protected_paths": [
      ".github/workflows/**"
    ],
    "protected_paths_rule": "never modify, delete or rename an existing file here; adding a new workflow is allowed only when no existing workflow runs on pull requests",
    "never_weaken_tests": true,
    "stale_pr_days": 7
  },
  "rotation_policy": {
    "repos_per_run": 2,
    "items_per_repo": 1
  },
  "genesis": {
    "cadence_days": 28,
    "min_days_between_runs": 27,
    "duplicate_guard_days": 21,
    "stale_lease_hours": 6
  },
  "review": {
    "dependabot_rebase_attempts": 2,
    "pr_ci_poll_minutes": 20
  }
}
